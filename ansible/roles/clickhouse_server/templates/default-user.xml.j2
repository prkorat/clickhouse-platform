<!-- Managed by Ansible. Neutralize the built-in 'default' user: random hash per host, never stored anywhere. -->
<clickhouse>
  <users>
    <default>
      <password remove="1"/>
      <no_password remove="1"/>
      <password_sha256_hex>{{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['hexdigits']) | lower | hash('sha256') }}</password_sha256_hex>
      <networks replace="replace"><ip>127.0.0.1</ip></networks>
      <access_management>0</access_management>
      <profile>readonly</profile>
    </default>
  </users>
</clickhouse>
